{
  "name": "vinta-django-questionnaires-client",
  "version": "0.2.1",
  "description": "Zod schemas and a React editor for questionnaires defined with vinta-django-questionnaires.",
  "license": "MIT",
  "keywords": [
    "django",
    "questionnaire",
    "forms",
    "validation",
    "zod",
    "react"
  ],
  "author": "Vinta Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vintasoftware/vinta-django-questionnaires.git",
    "directory": "client"
  },
  "homepage": "https://github.com/vintasoftware/vinta-django-questionnaires/tree/main/client#readme",
  "bugs": {
    "url": "https://github.com/vintasoftware/vinta-django-questionnaires/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./editor.css": "./dist/editor.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "jmespath": "^0.16.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@testing-library/react": "^16.1.0",
    "@types/jmespath": "^0.15.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/modifiers": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "react": {
      "optional": true
    },
